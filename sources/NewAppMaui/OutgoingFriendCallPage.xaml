<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewAppMaui.OutgoingFriendCallPage"
             Title="Calling">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label x:Name="TitleLabel" Text="Calling..." FontSize="24" />
        <Label x:Name="StatusLabel" Text="Starting..." />
        <Label x:Name="RoomCodeLabel" Text="" FontFamily="Consolas" />

        <ActivityIndicator x:Name="Loading" IsRunning="True" IsVisible="True" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <Button Text="Cancel" Clicked="OnCancelClicked" />
    </VerticalStackLayout>

</ContentPage>
