<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewAppMaui.FriendsPage"
             Title="Friends">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Add friend" FontAttributes="Bold" />

            <Entry x:Name="UsernameEntry" Placeholder="Username" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Add" Clicked="OnAddClicked" />
                <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" />
            </Grid>

            <Label Text="Requests" FontAttributes="Bold" />

            <CollectionView x:Name="PendingView" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="6" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding FromUsername}" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="Accept" Clicked="OnAcceptClicked" CommandParameter="{Binding FriendshipId}" />
                            <Button Grid.Column="2" Text="Reject" Clicked="OnRejectClicked" CommandParameter="{Binding FriendshipId}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Pending (sent)" FontAttributes="Bold" />

            <CollectionView x:Name="PendingSentView" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="6" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding ToUsername}" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelPendingClicked" CommandParameter="{Binding FriendshipId}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Friends" FontAttributes="Bold" />

            <CollectionView x:Name="FriendsView" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="6" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Username}" FontAttributes="Bold" />
                                <Label Text="{Binding IsOnline, StringFormat='Online: {0}'}" FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="Call" Clicked="OnCallClicked" CommandParameter="{Binding UserId}" />
                            <Button Grid.Column="2" Text="Remove" Clicked="OnRemoveClicked" CommandParameter="{Binding UserId}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
