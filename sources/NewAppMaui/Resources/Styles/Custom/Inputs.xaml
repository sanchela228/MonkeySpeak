<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="CodeCharEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundHover}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Keyboard" Value="Plain" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

</ResourceDictionary>
