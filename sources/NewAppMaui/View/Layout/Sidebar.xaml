<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Layout.Sidebar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors">

    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="#141416"
          Padding="12">

        <!-- Menu items -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" 
                  Padding="0,0,0,2" Margin="0,0,0,8">
                <Image
                    WidthRequest="30"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    Margin="0,4,0,0"
                    VerticalOptions="Center"
                    Source="logo_mini.png" />

                <Label
                    Grid.Column="1"
                    Text="MonkeySpeak"
                    FontFamily="Midami"
                    FontSize="18"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="2"
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollapseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="angle_right.png"
                           WidthRequest="16" HeightRequest="16"
                           Rotation="180"
                           Opacity="0.4" />
                </Border>
            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="#242426"
                     Margin="-12,0,-12,4" />

            <!-- In Call widget (hidden by default) -->
            <Border
                x:Name="CallMenuItem"
                IsVisible="False"
                Padding="0"
                StrokeThickness="0"
                Margin="0,6,0,6"
                BackgroundColor="#14251d"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="0">

                    <!-- Top: room code + timer + count (clickable) -->
                    <Border
                        Padding="12, 10, 12, 8"
                        StrokeThickness="0"
                        Margin="4"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12">
                        <Border.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCallTapped" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#132b17" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                x:Name="CallRoomCodeLabel"
                                Text="------"
                                FontFamily="JetBrainsMono"
                                FontSize="18"
                                TextColor="{StaticResource TextPrimary}"
                                CharacterSpacing="3"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                    <Border
                                        WidthRequest="8" HeightRequest="8"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource AccentGreen}"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="CallTimerLabel"
                                        Text="00:00"
                                        FontFamily="JetBrainsMono"
                                        FontSize="14"
                                        TextColor="{StaticResource AccentGreen}" />
                                </HorizontalStackLayout>
                                <Label
                                    x:Name="CallParticipantsLabel"
                                    Text="1 in call"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    
                    <!-- Bottom: audio controls -->
                    <Grid ColumnDefinitions="*,*,*" HeightRequest="44">

                        <Border
                            x:Name="CallVolumeBtn"
                            Margin="4"
                            StrokeThickness="0"
                            BackgroundColor="#091a0d"
                            StrokeShape="RoundRectangle 12">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallVolumeTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#132b17" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image x:Name="CallVolumeIcon"
                                   Source="volume.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="4"
                            x:Name="CallMicBtn"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#091a0d">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallMicTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#132b17" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image x:Name="CallMicIcon"
                                   Source="micro.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="4"
                            x:Name="CallHangupBtn"
                            StrokeThickness="0"
                            BackgroundColor="#091a0d"
                            StrokeShape="RoundRectangle 12">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallHangupTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#2a1515" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image Source="drop_call.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="MenuItem1"
                Padding="12,10"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 10">
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenu1Tapped" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1a2e1f" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image x:Name="MenuItem1Icon" Source="phone.png"
                           WidthRequest="20" HeightRequest="20"
                           VerticalOptions="Center" />
                    <Label x:Name="MenuItem1Label" Grid.Column="1" Text="P2P Call"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border
                x:Name="MenuItem2"
                Padding="12,10"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 10">
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenu2Tapped" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1a1a1a" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image x:Name="MenuItem2Icon" Source="custom_conn.png"
                           WidthRequest="20" HeightRequest="20"
                           VerticalOptions="Center" />
                    <Label x:Name="MenuItem2Label" Grid.Column="1" Text="Test Page 2"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="14"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- Friends placeholder -->
        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,16,0,0">
            <Label Text="FRIENDS"
                   FontSize="11"
                   TextColor="{StaticResource TextMuted}"
                   CharacterSpacing="1"
                   Padding="12,0" />

            <Label Text="Coming soon..."
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   Padding="12,8" />
        </VerticalStackLayout>

        <!-- User panel -->
        <Border
            Grid.Row="2"
            Padding="12,10"
            StrokeThickness="0"
            BackgroundColor="{StaticResource CardBackground}"
            StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 16">
                    <Label Text="U"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    x:Name="UsernameLabel"
                    Text="User"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="13"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />

                <Border
                    Grid.Column="2"
                    WidthRequest="28" HeightRequest="28"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 14">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="custom_conn.png"
                           WidthRequest="18" HeightRequest="18"
                           Opacity="0.5" />
                </Border>
            </Grid>
        </Border>

    </Grid>

</ContentView>
