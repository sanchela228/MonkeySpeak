<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Layout.Sidebar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors"
    xmlns:layout="clr-namespace:NewAppMaui.View.Layout"
    xmlns:components="clr-namespace:NewAppMaui.View.Components">

    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="#141416"
          Padding="12">

        <!-- Menu items -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" 
                  Padding="0,0,0,2" Margin="0,0,0,8">
                <Image
                    WidthRequest="30"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    Margin="0,4,0,0"
                    VerticalOptions="Center"
                    Source="logo_mini.png" />

                <Label
                    Grid.Column="1"
                    Text="MonkeySpeak"
                    FontFamily="Midami"
                    FontSize="18"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="2"
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollapseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="angle_right.png"
                           WidthRequest="16" HeightRequest="16"
                           Rotation="180"
                           Opacity="0.4" />
                </Border>
            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="#242426"
                     Margin="-12,0,-12,4" />

            <layout:SidebarIncomingCallWidget
                x:Name="IncomingCallView" />

            <layout:SidebarActiveCallWidget
                x:Name="ActiveCallView" />

            <layout:SidebarMenuItem
                x:Name="MenuItem1"
                Text="P2P Call"
                IconSource="phone.png"
                IconSourceActive="phone_green.png"
                TextColorActive="#22c55e"
                ActiveBackground="#14251d"
                HoverBackground="#1a2e1f"
                Clicked="OnMenu1Tapped" />

            <layout:SidebarMenuItem
                x:Name="MenuItem2"
                Text="P2P File Transfer"
                IconSource="repeat.png"
                IconSourceActive="repeat_green.png"
                TextColorActive="#22c55e"
                ActiveBackground="#14251d"
                HoverBackground="#1a2e1f"
                Clicked="OnMenu2Tapped" />

        </VerticalStackLayout>

        <!-- Friends -->
        <components:FriendsPanel
            x:Name="FriendsPanelView"
            Grid.Row="1"
            Margin="0,8,0,0" />

        <!-- User panel -->
        <Border
            Grid.Row="2"
            Padding="12,10"
            StrokeThickness="0"
            BackgroundColor="{StaticResource CardBackground}"
            StrokeShape="RoundRectangle 10">
            <Border.Behaviors>
                <behaviors:HandCursorBehavior />
            </Border.Behaviors>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsTapped" />
            </Border.GestureRecognizers>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#1a1a1a" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid WidthRequest="32" HeightRequest="32">
                    <Border
                        x:Name="UserAvatarBorder"
                        WidthRequest="32" HeightRequest="32"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16">
                        <Label x:Name="UserInitialsLabel"
                               Text="U"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Image
                        x:Name="UserAvatarImage"
                        WidthRequest="32" HeightRequest="32"
                        Aspect="AspectFill"
                        IsVisible="False">
                        <Image.Clip>
                            <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <Label
                    Grid.Column="1"
                    x:Name="UsernameLabel"
                    Text="User"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="13"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
