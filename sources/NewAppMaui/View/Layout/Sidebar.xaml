<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Layout.Sidebar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors"
    xmlns:layout="clr-namespace:NewAppMaui.View.Layout"
    xmlns:components="clr-namespace:NewAppMaui.View.Components">

    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="#141416"
          Padding="12">

        <!-- Menu items -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" 
                  Padding="0,0,0,2" Margin="0,0,0,8">
                <Image
                    WidthRequest="30"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    Margin="0,4,0,0"
                    VerticalOptions="Center"
                    Source="logo_mini.png" />

                <Label
                    Grid.Column="1"
                    Text="MonkeySpeak"
                    FontFamily="Midami"
                    FontSize="18"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="2"
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollapseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="angle_right.png"
                           WidthRequest="16" HeightRequest="16"
                           Rotation="180"
                           Opacity="0.4" />
                </Border>
            </Grid>

            <BoxView HeightRequest="1"
                     BackgroundColor="#242426"
                     Margin="-12,0,-12,4" />

            <!-- Incoming call widget (hidden by default) -->
            <Border
                x:Name="IncomingCallWidget"
                IsVisible="False"
                Padding="12,10"
                StrokeThickness="1"
                Stroke="{StaticResource AccentGreen}"
                BackgroundColor="#0d1f11"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="8">
                    <Label
                        x:Name="IncomingCallerLabel"
                        Text="Incoming call"
                        FontSize="13"
                        TextColor="{StaticResource TextPrimary}" />

                    <Label
                        Text="is calling you..."
                        FontSize="11"
                        TextColor="{StaticResource TextSecondary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            x:Name="IncomingAcceptBtn"
                            Text="Accept"
                            FontSize="12"
                            HeightRequest="34"
                            BackgroundColor="{StaticResource AccentGreen}"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnIncomingAcceptClicked" />
                        <Button
                            x:Name="IncomingRejectBtn"
                            Grid.Column="1"
                            Text="Decline"
                            FontSize="12"
                            HeightRequest="34"
                            BackgroundColor="{StaticResource CardBorder}"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnIncomingRejectClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- In Call widget (hidden by default) -->
            <Border
                x:Name="CallMenuItem"
                IsVisible="False"
                Padding="0"
                StrokeThickness="0"
                Margin="0,6,0,6"
                BackgroundColor="#14251d"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="0">

                    <!-- Top: room code + timer + count (clickable) -->
                    <Border
                        Padding="12, 10, 12, 8"
                        StrokeThickness="0"
                        Margin="4"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 12">
                        <Border.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCallTapped" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#132b17" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                x:Name="CallRoomCodeLabel"
                                Text="------"
                                FontFamily="JetBrainsMono"
                                FontSize="18"
                                TextColor="{StaticResource TextPrimary}"
                                CharacterSpacing="3"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                    <Border
                                        WidthRequest="8" HeightRequest="8"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource AccentGreen}"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="CallTimerLabel"
                                        Text="00:00"
                                        FontFamily="JetBrainsMono"
                                        FontSize="14"
                                        TextColor="{StaticResource AccentGreen}" />
                                </HorizontalStackLayout>
                                <Label
                                    x:Name="CallParticipantsLabel"
                                    Text="1 in call"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    
                    <!-- Bottom: audio controls -->
                    <Grid ColumnDefinitions="*,*,*" HeightRequest="44">

                        <Border
                            x:Name="CallVolumeBtn"
                            Margin="4"
                            StrokeThickness="0"
                            BackgroundColor="#0E1A14"
                            StrokeShape="RoundRectangle 12">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallVolumeTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#132b17" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image x:Name="CallVolumeIcon"
                                   Source="volume.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="4"
                            x:Name="CallMicBtn"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#0E1A14">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallMicTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#132b17" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image x:Name="CallMicIcon"
                                   Source="micro.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="4"
                            x:Name="CallHangupBtn"
                            StrokeThickness="0"
                            BackgroundColor="#0E1A14"
                            StrokeShape="RoundRectangle 12">
                            <Border.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCallHangupTapped" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#2a1515" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Image Source="drop_call.png"
                                   WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <layout:SidebarMenuItem
                x:Name="MenuItem1"
                Text="P2P Call"
                IconSource="phone.png"
                IconSourceActive="phone_green.png"
                TextColorActive="#22c55e"
                ActiveBackground="#14251d"
                HoverBackground="#1a2e1f"
                Clicked="OnMenu1Tapped" />

            <layout:SidebarMenuItem
                x:Name="MenuItem2"
                Text="Test Page 2"
                IconSource="custom_conn.png"
                HoverBackground="#1a1a1a"
                Clicked="OnMenu2Tapped" />

        </VerticalStackLayout>

        <!-- Friends -->
        <components:FriendsPanel
            x:Name="FriendsPanelView"
            Grid.Row="1"
            Margin="0,8,0,0" />

        <!-- User panel -->
        <Border
            Grid.Row="2"
            Padding="12,10"
            StrokeThickness="0"
            BackgroundColor="{StaticResource CardBackground}"
            StrokeShape="RoundRectangle 10">
            <Border.Behaviors>
                <behaviors:HandCursorBehavior />
            </Border.Behaviors>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsTapped" />
            </Border.GestureRecognizers>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal" />
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#1a1a1a" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid WidthRequest="32" HeightRequest="32">
                    <Border
                        x:Name="UserAvatarBorder"
                        WidthRequest="32" HeightRequest="32"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 16">
                        <Label x:Name="UserInitialsLabel"
                               Text="U"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Image
                        x:Name="UserAvatarImage"
                        WidthRequest="32" HeightRequest="32"
                        Aspect="AspectFill"
                        IsVisible="False">
                        <Image.Clip>
                            <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <Label
                    Grid.Column="1"
                    x:Name="UsernameLabel"
                    Text="User"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="13"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
