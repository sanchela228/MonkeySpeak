<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Layout.SidebarActiveCallWidget"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors"
    IsVisible="False">

    <Border
        Padding="0"
        StrokeThickness="0"
        Margin="0,6,0,6"
        BackgroundColor="{StaticResource AccentGreenBackground}"
        StrokeShape="RoundRectangle 12">

        <VerticalStackLayout Spacing="0">

            <!-- Top: room code + timer + count (clickable) -->
            <Border
                Padding="12, 10, 12, 8"
                StrokeThickness="0"
                Margin="4"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 12">
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCallTapped" />
                </Border.GestureRecognizers>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#132b17" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        x:Name="CallRoomCodeLabel"
                        Text="------"
                        FontFamily="JetBrainsMono"
                        FontSize="18"
                        TextColor="{StaticResource TextPrimary}"
                        CharacterSpacing="3"
                        VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                            <Border
                                WidthRequest="8" HeightRequest="8"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource AccentGreen}"
                                StrokeShape="RoundRectangle 4"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="CallTimerLabel"
                                Text="00:00"
                                FontFamily="JetBrainsMono"
                                FontSize="14"
                                TextColor="{StaticResource AccentGreen}" />
                        </HorizontalStackLayout>
                        <Label
                            x:Name="CallParticipantsLabel"
                            Text="1 in call"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Bottom: audio controls -->
            <Grid ColumnDefinitions="*,*,*" HeightRequest="44">

                <Border
                    Margin="4"
                    StrokeThickness="0"
                    BackgroundColor="#0E1A14"
                    StrokeShape="RoundRectangle 12">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolumeTapped" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#132b17" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Image x:Name="CallVolumeIcon"
                           Source="volume.png"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="4"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#0E1A14">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMicTapped" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#132b17" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Image x:Name="CallMicIcon"
                           Source="micro.png"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Column="2"
                    Margin="4"
                    StrokeThickness="0"
                    BackgroundColor="#0E1A14"
                    StrokeShape="RoundRectangle 12">
                    <Border.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHangupTapped" />
                    </Border.GestureRecognizers>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#2a1515" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Image Source="drop_call.png"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
