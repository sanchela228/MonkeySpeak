<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewAppMaui.LoginPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout Padding="30" Spacing="16"
                         MaximumWidthRequest="450"
                         VerticalOptions="Center">
        <Label Text="MonkeySpeak" FontSize="28" HorizontalOptions="Center" />
        <Label Text="Server requires login" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />

        <Entry x:Name="UsernameEntry" Placeholder="Username" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
        <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

        <Button x:Name="LoginBtn" Text="Login" 
                Style="{StaticResource GreenMainButton}"
                Clicked="OnLoginClicked" />
        <Button
            x:Name="DeleteButton"
            Text="Change Server"
            Style="{StaticResource GrayOutBorderButton}"
            Clicked="OnBackClicked" />
        
        
    </VerticalStackLayout>

</ContentPage>
