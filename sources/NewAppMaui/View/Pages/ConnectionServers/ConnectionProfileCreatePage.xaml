<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NewAppMaui.ConnectionProfileCreatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">
    
    <Grid Padding="24" MaximumWidthRequest="450"
          RowDefinitions="*,Auto,Auto,Auto,60,Auto,*" RowSpacing="8">

        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Label
                FontSize="20"
                TextColor="White"
                Text="Servers" />

            <Label
                FontSize="14"
                TextColor="#888"
                Text="Choose relay server" />
        </VerticalStackLayout>
        
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="12">
                <Label FontSize="18" Text="Create custom connection" />

                <Entry x:Name="NameEntry" Placeholder="Name" />
                <Entry x:Name="DomainEntry" Placeholder="Domain" />

                <Entry x:Name="PortEntry" Placeholder="Port" Keyboard="Numeric" />

                <HorizontalStackLayout Spacing="12">
                    <Label VerticalOptions="Center" Text="Use SSL" />
                    <Switch x:Name="UseSslSwitch" />
                </HorizontalStackLayout>

                <Entry x:Name="MaxRetriesEntry" Placeholder="Max retries" Keyboard="Numeric" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Cancel" Clicked="OnCancelClicked" />
                    <Button Grid.Column="1" Text="Create" Clicked="OnCreateClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>


</ContentPage>
