<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Pages.Content.P2PCallTestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="8">
        
        <Image
            WidthRequest="180"
            HeightRequest="180"
            Aspect="AspectFit"
            VerticalOptions="Center"
            Source="main_mks.png"
        />

        <Label
            Text="Create your p2p voice chat right now!"
            FontSize="14"
            HorizontalOptions="Center"
            TextColor="{StaticResource TextSecondary}" />

        <Label
            Text="A conversation without limits"
            FontSize="14"
            TextColor="{StaticResource TextSecondary}"
            HorizontalOptions="Center" />
        
        <Button
            Text="Create a Room"
            MaximumWidthRequest="450"
            Style="{StaticResource GreenMainButton}"
            Clicked="OnTestBackSettingsMenu"
            HorizontalOptions="Fill"
            Margin="0,38,0,0" />
        
        <Button
            Text="Connect"
            MaximumWidthRequest="450"
            Style="{StaticResource GrayMainButton}"
            Clicked="OnTestBackSettingsMenu"
            HorizontalOptions="Fill"
            Margin="0,8,0,0" />

    </VerticalStackLayout>

</ContentView>
