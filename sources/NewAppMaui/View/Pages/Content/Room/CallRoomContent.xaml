<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Pages.Content.CallRoomContent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Padding="24,20,24,0" Spacing="4">
            <Label
                x:Name="RoomCodeLabel"
                Text="-"
                FontFamily="JetBrainsMono"
                FontSize="24"
                TextColor="{StaticResource AccentGreen}"
                CharacterSpacing="4"
                HorizontalTextAlignment="Center" />
            <Label
                x:Name="StatusLabel"
                Text="Connected"
                FontSize="12"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Participants -->
        <ScrollView Grid.Row="1" x:Name="ParticipantsScroll" VerticalOptions="Fill">
            <VerticalStackLayout
                x:Name="ParticipantsPanel"
                VerticalOptions="Center"
                Spacing="12"
                Padding="16,0" />
        </ScrollView>

        <Label
            Grid.Row="1"
            x:Name="NoParticipantsLabel"
            Text="Ожидание участников..."
            FontSize="14"
            TextColor="{StaticResource TextSecondary}"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

        <!-- Chat (hidden by default) -->
        <ContentView Grid.Row="2" x:Name="ChatContainer" IsVisible="False" />

        <!-- Controls -->
        <HorizontalStackLayout
            x:Name="ControlsLayout"
            Grid.Row="2"
            HorizontalOptions="Center"
            Spacing="28"
            Padding="0,16,0,28">

            <!-- Mic -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border
                    x:Name="MicBorder"
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBorder}"
                    HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Image
                        x:Name="MicIcon"
                        Source="micro.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMicToggleClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Label
                    x:Name="MicLabel"
                    Text="Microphone"
                    FontSize="11"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Sound -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border
                    x:Name="SoundBorder"
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBorder}"
                    HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Image
                        x:Name="SoundIcon"
                        Source="volume.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlaybackToggleClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Label
                    x:Name="SoundLabel"
                    Text="Sound"
                    FontSize="11"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Chat -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Grid WidthRequest="56" HeightRequest="56" HorizontalOptions="Center">
                    <Border
                        x:Name="ChatBorder"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource CardBorder}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Image
                            Source="chat.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChatToggleClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border
                        x:Name="UnreadBadge"
                        IsVisible="False"
                        WidthRequest="18"
                        HeightRequest="18"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource AccentRed}"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,2,2,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="UnreadCountLabel"
                            Text=""
                            FontSize="9"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
                <Label
                    x:Name="ChatLabel"
                    Text="Chat"
                    FontSize="11"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Hang up -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource AccentRed}"
                    HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Image
                        Source="drop_call.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHangupClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Label
                    Text="Hang up"
                    FontSize="11"
                    TextColor="{StaticResource AccentRed}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </HorizontalStackLayout>

        <!-- Hidden pickers for programmatic audio device selection -->
        <Picker x:Name="CapturePicker"
                IsVisible="False"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndexChanged="OnCapturePickerChanged" />
        <Picker x:Name="PlaybackPicker"
                IsVisible="False"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndexChanged="OnPlaybackPickerChanged" />

    </Grid>

</ContentView>
