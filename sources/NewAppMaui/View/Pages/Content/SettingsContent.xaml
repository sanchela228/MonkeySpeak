<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Pages.Content.SettingsContent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors">

    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="32"
            Spacing="24"
            MaximumWidthRequest="450">

            <Label
                Text="Settings"
                FontSize="22"
                TextColor="{StaticResource TextPrimary}" />

            <!-- Avatar section -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Grid WidthRequest="96" HeightRequest="96"
                      HorizontalOptions="Center">

                    <Border
                        x:Name="AvatarBorder"
                        WidthRequest="96" HeightRequest="96"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource CardBorder}"
                        StrokeShape="RoundRectangle 48">
                        <Label
                            x:Name="AvatarInitials"
                            Text="UN"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Image
                        x:Name="AvatarImage"
                        WidthRequest="96" HeightRequest="96"
                        Aspect="AspectFill"
                        IsVisible="False">
                        <Image.Clip>
                            <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                        </Image.Clip>
                    </Image>

                    <!-- Hover overlay -->
                    <Border
                        x:Name="AvatarOverlay"
                        WidthRequest="96" HeightRequest="96"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 48"
                        Opacity="0">
                        <Border.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeAvatarClicked" />
                            <PointerGestureRecognizer
                                PointerEntered="OnAvatarPointerEntered"
                                PointerExited="OnAvatarPointerExited" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="2">
                            <Image Source="plus.png"
                                   WidthRequest="24" HeightRequest="24"
                                   HorizontalOptions="Center" />
                            <Label Text="change"
                                   FontSize="11"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label
                    x:Name="RemoveAvatarBtn"
                    Text="Remove"
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    TextDecorations="Underline"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    behaviors:HandCursor.Enabled="True">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRemoveAvatarClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- Username section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="USERNAME"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry
                        x:Name="UsernameEntry"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="15"
                        BackgroundColor="{StaticResource CardBackgroundHover}"
                        Placeholder="Username" />

                    <Button
                        Grid.Column="1"
                        x:Name="SaveUsernameBtn"
                        Text="Save"
                        Style="{StaticResource GreenMainButton}"
                        FontSize="12"
                        HeightRequest="40"
                        WidthRequest="80"
                        Clicked="OnSaveUsernameClicked" />
                </Grid>

                <Label
                    x:Name="UsernameHintLabel"
                    Text=""
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHandleLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    x:Name="UsernameErrorLabel"
                    Text=""
                    FontSize="12"
                    TextColor="#ef4444"
                    IsVisible="False" />

                <Label
                    x:Name="UsernameSuccessLabel"
                    Text="Username updated!"
                    FontSize="12"
                    TextColor="{StaticResource AccentGreen}"
                    IsVisible="False" />
            </VerticalStackLayout>

            <!-- Audio devices section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="AUDIO DEVICES"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Microphone" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <Picker x:Name="CapturePicker"
                            Title="Select microphone"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnCapturePickerChanged" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Speakers" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <Picker x:Name="PlaybackPicker"
                            Title="Select speakers"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnPlaybackPickerChanged" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Volume section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="VOLUME"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" />

                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Microphone volume" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="MicVolumeLabel" Grid.Column="1" Text="100%" FontSize="13"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Slider x:Name="MicVolumeSlider"
                            Minimum="0" Maximum="200"
                            Value="100"
                            MinimumTrackColor="{StaticResource AccentGreen}"
                            MaximumTrackColor="{StaticResource CardBorder}"
                            ValueChanged="OnMicVolumeChanged" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Speaker volume" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="PlaybackVolumeLabel" Grid.Column="1" Text="100%" FontSize="13"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Slider x:Name="PlaybackVolumeSlider"
                            Minimum="0" Maximum="200"
                            Value="100"
                            MinimumTrackColor="{StaticResource AccentGreen}"
                            MaximumTrackColor="{StaticResource CardBorder}"
                            ValueChanged="OnPlaybackVolumeChanged" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Interface sounds" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="InterfaceSoundVolumeLabel" Grid.Column="1" Text="50%" FontSize="13"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Slider x:Name="InterfaceSoundVolumeSlider"
                            Minimum="0" Maximum="100"
                            Value="50"
                            MinimumTrackColor="{StaticResource AccentGreen}"
                            MaximumTrackColor="{StaticResource CardBorder}"
                            ValueChanged="OnInterfaceSoundVolumeChanged" />
                </VerticalStackLayout>

                <!-- Noise suppression -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="RNNoise suppression" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="AI-powered noise reduction" FontSize="11" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                    <Switch x:Name="NoiseSuppSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            Toggled="OnNoiseSuppressionToggled"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Server section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="SERVER"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" />

                <Border
                    Padding="12"
                    StrokeThickness="1"
                    Stroke="{StaticResource CardBorder}"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="ServerNameLabel" Text="-" FontSize="14"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="ServerAddressLabel" Text="-" FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Change server"
                    Style="{StaticResource GrayMainButton}"
                    Clicked="OnChangeServerClicked" />
            </VerticalStackLayout>

            <!-- User info -->
            <VerticalStackLayout Spacing="4">
                <Label Text="ACCOUNT INFO"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       CharacterSpacing="1" />

                <Label
                    x:Name="UserIdLabel"
                    Text=""
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}" />

                <Label
                    x:Name="UserCodeLabel"
                    Text=""
                    FontSize="12"
                    TextColor="{StaticResource TextSecondary}"
                    TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHandleLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    x:Name="ProfilePathLabel"
                    Text=""
                    FontSize="11"
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
