<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Components.FriendCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors">

    <Border
        x:Name="Container"
        Padding="8,6"
        StrokeThickness="0"
        BackgroundColor="Transparent"
        StrokeShape="RoundRectangle 8">
        <Border.Behaviors>
            <behaviors:HandCursorBehavior />
        </Border.Behaviors>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1a1a1a" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

            <!-- Avatar with online indicator -->
            <Grid WidthRequest="36" HeightRequest="36">
                <Border
                    WidthRequest="36" HeightRequest="36"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 18">
                    <Label
                        x:Name="AvatarLabel"
                        Text="UN"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- Online indicator dot -->
                <Border
                    x:Name="OnlineDot"
                    IsVisible="False"
                    WidthRequest="12" HeightRequest="12"
                    StrokeThickness="2"
                    Stroke="#111111"
                    BackgroundColor="{StaticResource AccentGreen}"
                    StrokeShape="RoundRectangle 6"
                    HorizontalOptions="End"
                    VerticalOptions="End" />
            </Grid>

            <!-- Name + status -->
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label
                    x:Name="NameLabel"
                    Text="Username"
                    FontSize="13"
                    TextColor="{StaticResource TextPrimary}"
                    LineBreakMode="TailTruncation" />
                <Label
                    x:Name="StatusLabel"
                    Text="Online"
                    FontSize="11"
                    TextColor="{StaticResource AccentGreen}"
                    IsVisible="False" />
            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
