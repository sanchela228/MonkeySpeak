<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NewAppMaui.View.Components.PendingRequestCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:NewAppMaui.Behaviors">

    <Border
        Padding="8,6"
        StrokeThickness="1"
        Stroke="#1a3d1f"
        BackgroundColor="#0d1f11"
        StrokeShape="RoundRectangle 8">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

            <!-- Avatar -->
            <Border
                WidthRequest="32" HeightRequest="32"
                StrokeThickness="0"
                BackgroundColor="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 16">
                <Label
                    x:Name="AvatarLabel"
                    Text="UN"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Name -->
            <Label
                Grid.Column="1"
                x:Name="NameLabel"
                Text="Username"
                FontSize="13"
                TextColor="{StaticResource TextPrimary}"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />

            <!-- Accept -->
            <Border
                Grid.Column="2"
                WidthRequest="28" HeightRequest="28"
                StrokeThickness="0"
                BackgroundColor="{StaticResource AccentGreen}"
                StrokeShape="RoundRectangle 14">
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAcceptTapped" />
                </Border.GestureRecognizers>
                <Label Text="✓"
                       FontSize="14"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Reject -->
            <Border
                Grid.Column="3"
                WidthRequest="28" HeightRequest="28"
                StrokeThickness="0"
                BackgroundColor="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 14">
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRejectTapped" />
                </Border.GestureRecognizers>
                <Label Text="✕"
                       FontSize="14"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

        </Grid>
    </Border>

</ContentView>
