<?xml version="1.0" encoding="utf-8"?>
<Window Title="MonkeySpeak">
    <Rect Width="100%" Height="45" MarginLeft="6" MarginRight="6" MarginTop="6"
          Color="Blue" OnPress="{Window.Drag()}">
        <Grid Columns="3" MarginLeft="Auto" Gap="10" MarginRight="15" Height="100%" Width="Auto">
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18" Cursor="4"
                    OnRelease="{Window.Minimize()}"
                    Color="Yellow"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.ToggleMaximize()}"
                    Color="Green"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.Close()}"
                    Color="Red"
            />
        </Grid>
    </Rect>
    <Text>Testing text</Text>
    
    <Grid Columns="1fr 1fr 1fr" ColumnGap="5" Width="100%" Height="100" MarginTop="10" Padding="10">
        <Rect Width="100%" Height="100%" Color="Red"/>
        <Rect Width="100%" Height="100%" Color="Blue"/>
        <Rect Width="100%" Height="100%" Color="Red"/>
    </Grid>
</Window>
