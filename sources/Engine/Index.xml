<?xml version="1.0" encoding="utf-8"?>
<Window Title="MonkeySpeak">
    <Rect Width="100%" Height="45"
          Color="Blank" OnPress="{Window.Drag()}">
        <Grid Columns="3" MarginLeft="Auto" Gap="10" MarginRight="15" Height="100%" Width="Auto">
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.Minimize()}"
                    Color="Yellow"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.ToggleMaximize()}"
                    Color="Green"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.Close()}"
                    Color="Red"
            />
        </Grid>
    </Rect>
    
    <Grid Columns="3" Gap="10" Width="100%" Height="Auto" MarginTop="50" Padding="10">
        <Rect Width="100%" Height="80" Color="Red"/>
        <Rect Width="100%" Height="80" Color="Green"/>
        <Rect Width="100%" Height="80" Color="Blue"/>
        <Rect Width="100%" Height="60" Color="Yellow"/>
        <Rect Width="100%" Height="100" Color="Orange"/>
        <Rect Width="100%" Height="40" Color="Purple"/>
    </Grid>
    
    <Grid Columns="1fr 10fr 1fr" ColumnGap="5" Width="100%" Height="100" MarginTop="10" Padding="10">
        <Rect Width="100%" Height="100%" Color="Red"/>
        <Rect Width="100%" Height="100%" Color="Blue"/>
        <Rect Width="100%" Height="100%" Color="Red"/>
    </Grid>
</Window>
