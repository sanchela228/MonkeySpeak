<?xml version="1.0" encoding="utf-8"?>
<Window Title="MonkeySpeak">
    <Include Source="Fonts.xml"/>
    <Rect Width="100%" Height="45" MarginLeft="6" MarginRight="6" MarginTop="6"
          Color="Blue" OnPress="{Window.Drag()}">
        <Grid Columns="3" MarginLeft="Auto" Gap="10" MarginRight="15" Height="100%" Width="Auto">
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18" Cursor="4"
                    OnRelease="{Window.Minimize()}"
                    Color="Yellow"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.ToggleMaximize()}"
                    Color="Green"
            />
            <Circle MarginTop="Auto" MarginBottom="Auto"
                    Width="18" Height="18"
                    OnRelease="{Window.Close()}"
                    Color="Red"
            />
        </Grid>
    </Rect>
    <Text Content="Hello World!"
          FontFamily="JET"
          Wrap="true"
          ClampDots="true"
          Width="Auto"
          Height="Auto"/>
    <Rect Width="100%" Height="Auto" Color="Blue">
        <Text Content="long text long text long text long text long text long text long text long text long text long text long text long text long text long text long text"
              FontFamily="JET"
              Height="Auto"
              Align="Left"
              ClampDots="true"
              Wrap="True"
        />
    </Rect>
</Window>
