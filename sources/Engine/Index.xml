<?xml version="1.0" encoding="utf-8"?>
<Window Title="MonkeySpeak">
    <Scene Layout="Horizontal" PositionMode="Absolute" MarginTop="10" MarginRight="10" MarginLeft="Auto">
        <Circle 
            Width="30"
            Height="30" 
            OnRelease="{Window.Minimize()}"
            Color="Yellow"
        />
        <Circle 
            Width="30"
            Height="30"
            MarginLeft="10"
            OnRelease="{Window.ToggleMaximize()}"
            Color="Green"
        />
        <Circle 
            Width="30"
            Height="30"
            MarginLeft="10"
            OnRelease="{Window.Close()}"
            Color="Red"
        />
    </Scene>
</Window>
